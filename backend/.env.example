# NyayaSetu Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# Supabase
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Server-only. Full DB & admin auth access.
SUPABASE_ANON_KEY=eyJ...           # Optional: public anon key.

# Google Gemini
GEMINI_API_KEY=AIza...

# Sarvam AI
SARVAM_API_KEY=sk-...

# CORS — must exactly match your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://nyayasetu.vercel.app

# Port (Render injects this automatically — only needed for local dev)
PORT=10000
