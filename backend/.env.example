# NyayaSetu Backend — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# ── Supabase REST / Auth API ──────────────────────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Server-only. Full DB & admin auth access. Never expose client-side.
SUPABASE_ANON_KEY=eyJ...           # Public/anon key for browser / client SDK calls.

# ── Supabase Postgres (Supavisor Connection Pooler) ───────────────────────────
# CRITICAL FOR RENDER DEPLOYMENT:
# Render runs on IPv4, whereas direct Supabase Postgres (port 5432) uses IPv6.
# Direct port 5432 connections fail with ECONNREFUSED on Render.
# You MUST use the Supavisor Transaction Pooler on port 6543 which provides IPv4 support.
#
# Where to get:
# Supabase Dashboard > Project Settings > Database > Connection pooling
# 1. Mode: Transaction
# 2. Port: 6543
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── AI Services ──────────────────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.6-flash

# Sarvam AI (OCR & Translation): https://dashboard.sarvam.ai
SARVAM_API_KEY=sk-...

# ── CORS ─────────────────────────────────────────────────────────────────────
# Must match your Vercel frontend URL exactly (no trailing slash)
# For local development: FRONTEND_URL=http://localhost:3000
FRONTEND_URL=https://nyayasetu.vercel.app

# ── Server ───────────────────────────────────────────────────────────────────
# Render automatically provides and injects PORT. For local dev use 4000 or 10000.
PORT=10000
NODE_ENV=production
