{
  "name": "nyayasetu-backend",
  "version": "1.0.0",
  "description": "NyayaSetu backend - Express + TypeScript API server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npm install && tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "npm install && tsc && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.47.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "typescript": "^5.7.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}
