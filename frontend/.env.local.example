# NyayaSetu Frontend — Environment Variables
# Copy this file to .env.local for local development.
# On Vercel, set NEXT_PUBLIC_API_URL in Project Settings > Environment Variables.

# URL of your NyayaSetu Express backend
# For local dev: http://localhost:4000
# For production (Render): https://nyayasetu-api-ohnr.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000
